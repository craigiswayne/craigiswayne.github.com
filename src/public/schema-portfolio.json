{
  "title": "Portfolio Data Schema",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "version": 1,
  "type": "object",
  "properties": {
    "$schema": {
      "description": "JSON schema URI for schema-portfolio.json.",
      "type": "string"
    },
    "first_names": {
      "description": "All first names, including middle names",
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "latest_role": {
      "description": "Optional. If this property is not set, the role at your most recent employment will be used",
      "type": "string"
    },
    "contact": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string",
          "description": "Phone number in E.164 format (e.g., +447624401629)",
          "pattern": "^\\+[1-9]\\d{1,14}$"
        }
      },
      "additionalProperties": false,
      "required": [
        "email",
        "phone"
      ]
    },
    "location": {
      "description": "Optional. If this property is not set, the location at your most recent employment will be used",
      "type": "string"
    },
    "social": {
      "description": "Just the usernames for the social media entries",
      "type": "object",
      "properties": {
        "linkedin": {
          "type": "string"
        },
        "github": {
          "type": "string"
        }
      },
      "required": ["linkedin"]
    },
    "work_experience": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "logo": {
                "type": "string",
                "format": "uri"
              }
            },
            "required": [
              "name",
              "url",
              "logo"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              },
              "country": {
                "type": "string"
              }
            }
          },
          "period": {
            "type": "object",
            "properties": {
              "start": {
                "type": "string"
              },
              "end": {
                "type": "string"
              }
            },
            "required": ["start"]
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "technologies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "organization",
          "location",
          "period",
          "responsibilities",
          "technologies"
        ]
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {

        }
      }
    },
    "extra_skills_and_technologies": {
      "type": "array",
      "items": {
        "type": "string",
        "minItems": 1
      }
    },
    "skills_from_work_experience_and_extra_skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minItems": 1
      }
    }
  },
  "required": [
    "first_names",
    "last_name",
    "summary",
    "work_experience",
    "education",
    "extra_skills_and_technologies",
    "skills_from_work_experience_and_extra_skills"
  ],
  "additionalProperties": false
}
