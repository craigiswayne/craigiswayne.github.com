doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{first_names} #{last_name} - Resume
    link(href="styles.css" rel="stylesheet" type="text/css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
  body
    .a4-page
      header
        h1 #{first_names} #{last_name}
        h2 #{latest_role}
        .contact-info
          span
            i.fas.fa-map-marker-alt
            | #{location}
          span
            i.fas.fa-envelope
            a(href=`mailto:${contact.email}`)
              | #{contact.email}
          span
            i.fas.fa-mobile-alt
            a(target="_blank" href=`tel:${contact.phone}`)
              | #{contact.phone}
          span
            i.fab.fa-linkedin
            a(target="_blank" href=`https://www.linkedin.com/in/${contact.linkedin_username}`)
              | in/#{contact.linkedin_username}
        p.summary #{summary}

      section.experience
        .title EMPLOYMENT
        each experience in work_experience
          .item
            header
              h4.title #{experience.position}
                .date
                 | #{experience.period.start} - #{experience.period.end}
              .subtitle
                span.organization #{experience.organization}
                span.location #{experience.location.country}
            ul
              each responsibility in experience.responsibilities
                li= responsibility

      section.education
        .title EDUCATION
        each edu in education
          .item
            header
              h4.title #{edu.degree_level} Degree in #{edu.discipline} (#{edu.majors})
                .date
                  | #{edu.period.start} - #{edu.period.end}
              .subtitle
                span.organization #{edu.institution_name}
                span.location #{edu.location.country}

      section.skills
        .title SKILLS
        .content
          - const sorted_skills = skills.sort()
          each skill, index in sorted_skills
            span= skill
            if index < sorted_skills.length - 1
              | ,

  .supported-brands.muted
    .title Supported Products
